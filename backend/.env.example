# Copy this file to .env and fill in real values.

# MongoDB — use your local mongod for dev, or a MongoDB Atlas connection string in production
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=translator

# OpenAI — your own API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
# Optional: override the translation model (default shown)
# OPENAI_MODEL=gpt-5.2

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=sk_test_your-key-here
# Webhook signing secret — https://dashboard.stripe.com/webhooks (endpoint: https://YOUR-HOST/api/webhook/stripe)
STRIPE_WEBHOOK_SECRET=whsec_your-secret-here

# CORS — comma-separated allowed origins (the URL where the frontend is served)
CORS_ORIGINS=*
